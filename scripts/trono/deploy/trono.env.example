# Defiende el Trono — configuracion de la nube.
#
# Va en /etc/trono/trono.env, NO en el repo. Permisos: 600, owner root:trono.
#   sudo install -o root -g trono -m 600 trono.env.example /etc/trono/trono.env
#
# Los secretos (usuario y clave del juego) NO van aqui: viven en
# /home/trono/.trono/credentials.json con permisos 600, que es la ruta que
# lib/credentials.js ya busca. Este archivo solo lleva configuracion.

# --- transporte -------------------------------------------------------------
# http: sin navegador. Es la unica modalidad viable en una VM sin X, y la que
# ejercita el login headless. No cambiar a browser/hybrid en la nube.
TRONO_MODE=http

# --- seguridad del agente ---------------------------------------------------
# LIVE=1 permite mutaciones (peleas, cofres, claims). Sin esto el agente mira y
# no toca nada, que es lo correcto para un primer arranque de humo.
TRONO_LIVE=1

# Tope de oro que el crafteo puede gastar por tick. 0 = crafteo apagado.
# 300 fue la Decision del humano; subirlo es una decision suya, no del agente.
TRONO_CRAFT_MAX_GOLD=300

# Cofres por tick.
TRONO_CHESTS_PER_TICK=5

# Segundos entre ticks. El cuello de botella es la estamina, no el reloj.
TRONO_LOOP=300

# --- dormancia --------------------------------------------------------------
# Se acuesta entre 23:30 y 00:30 y despierta entre 05:30 y 06:30 (hora Cuba),
# sorteado por noche con semilla de la fecha: un reinicio no cambia la hora.
# Durante la ventana no se emite UN SOLO request (ni login ni heartbeat).
#
# TRONO_TZ_OFFSET_MIN: minutos respecto de UTC. Cuba mantiene el horario de
# verano de forma permanente, asi que la hora real del pais es UTC-4 todo el
# ano. NO usar Intl/America/Havana: la tzdata todavia registra la vuelta a
# UTC-5 el 2026-11-02 y devuelve una hora de menos.
TRONO_QUIET=1
TRONO_TZ_OFFSET_MIN=-240

# Override opcional de la ventana (si se ponen las DOS, no se sortea nada).
# TRONO_QUIET_START=00:00
# TRONO_QUIET_END=07:00

# --- rutas ------------------------------------------------------------------
# El runner y el control server tienen que escribir y leer EL MISMO log: si
# divergen, el panel del Hub se queda en blanco con el agente trabajando.
TRONO_STATE_DIR=/opt/trono/scripts/trono/state
TRONO_LOG_DIR=/var/log/trono
TRONO_LOG_FILE=/var/log/trono/runner.log

# --- control server ---------------------------------------------------------
TRONO_CLOUD_PORT=8091
# Atar a la IP privada de la VM (o 127.0.0.1 con un tunel delante). 0.0.0.0
# deja el puerto expuesto a internet y el token pasa a ser la unica defensa.
TRONO_CLOUD_HOST=0.0.0.0
TRONO_MACHINE=oracle
# Token compartido con el Hub. Generar con: openssl rand -hex 24
TRONO_CLOUD_TOKEN=CAMBIAR_ESTO_openssl_rand_hex_24

# --- identidad de la nube ---------------------------------------------------
# Con esto puesto el runner NO se retira cuando la nube responde: el es la nube.
TRONO_ON_CLOUD=1
